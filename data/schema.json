{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/elchuzade/preapply/blob/main/data/schema.json",
  "title": "PreApply accelerator",
  "description": "One accelerator's application questions. File: data/accelerators/<country>/<id>.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "country", "website", "match", "last_verified", "steps"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case slug; must match the file name"
    },
    "name": { "type": "string", "minLength": 1 },
    "country": {
      "type": "string",
      "pattern": "^(global|[a-z]{2})$",
      "description": "'global' or a lowercase ISO 3166-1 alpha-2 code; must match the parent folder"
    },
    "website": { "type": "string", "pattern": "^https?://" },
    "status": {
      "enum": ["verified", "needs_verification"],
      "description": "Defaults to 'verified'. Use 'needs_verification' for placeholders whose questions nobody has checked yet."
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domains"],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+$" }
        },
        "apply_urls": {
          "type": "array",
          "items": { "type": "string", "pattern": "^https?://" }
        }
      }
    },
    "cohort": { "type": "string" },
    "deadline": { "$ref": "#/definitions/date" },
    "last_verified": {
      "type": ["string", "null"],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO date. May be null only while status is needs_verification."
    },
    "verified_by": { "type": "string" },
    "notes": { "type": "string" },
    "steps": { "type": "array", "items": { "$ref": "#/definitions/step" } }
  },
  "if": {
    "not": { "required": ["status"], "properties": { "status": { "const": "needs_verification" } } }
  },
  "then": {
    "properties": {
      "last_verified": { "type": "string" },
      "steps": { "minItems": 1 }
    }
  },
  "definitions": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "questions"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": "string", "description": "Text the form shows at the top of this step" },
        "questions": { "type": "array", "items": { "$ref": "#/definitions/question" } }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "type"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "hint": { "type": "string" },
        "required": { "type": "boolean" },
        "type": {
          "enum": ["short_text", "long_text", "url", "video", "file", "choice", "references", "other"]
        },
        "limit": { "type": "integer", "minimum": 1 },
        "limit_unit": { "enum": ["words", "characters"] }
      },
      "dependencies": { "limit_unit": ["limit"] }
    }
  }
}
